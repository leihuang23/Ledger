# Local compose profile that mirrors the anonymous public read-only demo.
# Usage:
#   cp .env.public-demo.example .env.public-demo
#   docker compose --env-file .env.public-demo up -d --build
#   ./scripts/verify-public-demo.sh
#   cd apps/web && PLAYWRIGHT_EXPECT_READ_ONLY=true npm run test:e2e:public-demo
#
# Do not put real production secrets here. Tokens below are local-only placeholders
# that prove the API still rejects anonymous callers when tokens are configured
# (Render generates real values server-side; they never go to the public web).

POSTGRES_DB=ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
APP_ENV=demo
DATABASE_URL=postgresql+psycopg://ledger:ledger@postgres:5432/ledger
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000
ALLOW_UNSAFE_BOOTSTRAP_SEED=false
LOG_LEVEL=INFO
LOG_FORMAT=text
API_INTERNAL_BASE_URL=http://api:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Public web: mutations off; no operator/eval/ingest tokens on the web service.
OPERATOR_UI_ENABLED=false
DEMO_OPERATOR_TOKEN=
EVAL_RUN_TOKEN=
DOCUMENT_INGEST_TOKEN=

# Deterministic offline diagnosis (matches Render Blueprint defaults).
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
LLM_PROVIDER=none
OBSERVABILITY_PROVIDER=local
OBSERVABILITY_FULL_PAYLOADS=false
RATE_LIMIT_MUTATIONS_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
