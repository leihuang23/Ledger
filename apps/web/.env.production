# Public build-time configuration for Cloudflare deploys. next build inlines
# NEXT_PUBLIC_API_BASE_URL into the browser bundle from this file; wrangler
# vars provide the same values at Worker runtime. Keep all secrets absent.
API_INTERNAL_BASE_URL=https://ledger-api.onrender.com
NEXT_PUBLIC_API_BASE_URL=https://ledger-api.onrender.com
OPERATOR_UI_ENABLED=false
