APP_NAME=ledger-api
APP_ENV=local
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://ledger:ledger@localhost:5432/ledger
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
BACKEND_CORS_ORIGINS=http://localhost:3000
ALLOW_UNSAFE_BOOTSTRAP_SEED=false
# Embedding provider: local (default, deterministic hashing), openai, or zhipu.
# Switching providers changes the embedding space, so re-run ingestion
# (`python -m app.knowledge.ingestion`) afterwards to re-embed existing
# chunks into the same space.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
# Zhipu embeddings (used when EMBEDDING_PROVIDER=zhipu)
ZHIPU_API_KEY=
ZHIPU_EMBEDDING_MODEL=embedding-3
DOCUMENT_INGEST_TOKEN=
EVAL_RUN_TOKEN=
DEMO_OPERATOR_TOKEN=
OBSERVABILITY_PROVIDER=auto
OBSERVABILITY_FULL_PAYLOADS=false
OBSERVABILITY_TIMEOUT_SECONDS=2
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_PROJECT_ID=
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ledger-local
LANGSMITH_WEB_URL=https://smith.langchain.com

# LLM configuration
LLM_PROVIDER=none
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
# Bounded ReAct investigation loop (only applies when LLM_PROVIDER is a real
# provider): max LLM decisions per run before deterministic fallback.
AGENT_MAX_ITERATIONS=8
# Set to false to pin a real provider back to single-shot diagnosis mode.
AGENT_LOOP_ENABLED=true
LOG_LEVEL=INFO
LOG_FORMAT=text
RATE_LIMIT_MUTATIONS_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=60
# Optional Stripe test-mode evidence adapter (sk_test_ only; not used when APP_ENV=demo)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
